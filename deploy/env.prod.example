# Production settings for docker-compose.prod.yml.
# Copy to .env.prod (in the project root) and fill in. NEVER commit .env.prod.

# Your domain (free options: a DuckDNS subdomain pointing at the server IP).
DOMAIN=chat.example.com
ALLOWED_HOSTS=chat.example.com
CSRF_TRUSTED_ORIGINS=https://chat.example.com
CORS_ALLOWED_ORIGINS=https://chat.example.com

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
SECURE_HSTS_SECONDS=31536000

# Google OAuth Web client ID. Authorize the production site's exact HTTPS origin
# in Google Cloud Console; do not place any client secret in this file.
GOOGLE_CLIENT_ID=

# Database (created automatically by the db container).
POSTGRES_DB=mhtalk
POSTGRES_USER=mhtalk
POSTGRES_PASSWORD=change-me-strong-password

# Worker processes. Rule of thumb: 2 per CPU core (1 on a 512 MB machine).
WEB_CONCURRENCY=2

# Voice/video call relay (start with: --profile turn). Any long random string.
TURN_SECRET=change-me-long-random-string
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# Cloud VMs sit behind NAT. Use "public-ip/private-ip" (Oracle: the public IP
# from the instance page, the private one from `hostname -I`). Empty = no NAT.
TURN_EXTERNAL_IP=

# SFU live video (same public HTTPS domain; set random credentials before deploy).
# Generate with: openssl rand -hex 16 (key), openssl rand -hex 32 (secret)
LIVEKIT_PUBLIC_URL=wss://chat.example.com
LIVEKIT_API_KEY=replace-with-openssl-rand-hex-16
LIVEKIT_API_SECRET=replace-with-openssl-rand-hex-32
# Server admission cap per live; keep within 1..2999. Actual capacity depends on
# CPU, RAM, egress bandwidth and open UDP/TCP firewall ports.
SOCIAL_LIVE_MAX_VIEWERS=1000
LIVEKIT_MAX_PARTICIPANTS=1001

# Marketplace settlement in NSAT. Off unless enabled here: turning on real
# payments is an explicit decision, and setting this to false stops new orders
# on the next restart without losing anything already sold. Fee is 0 bps, so
# creators receive the full listing price and no treasury address is needed;
# raising MARKETPLACE_PLATFORM_FEE_BPS above 0 requires MARKETPLACE_TREASURY_ADDRESS.
MARKETPLACE_LIVE_PAYMENTS=false
MARKETPLACE_PLATFORM_FEE_BPS=0
MARKETPLACE_TREASURY_ADDRESS=
MARKETPLACE_ORDER_TTL_SECONDS=900
# A submitted transfer unconfirmed this long is reported as stuck.
MARKETPLACE_RECONCILIATION_STALE_MINUTES=30
# Re-read confirmed transfers from this many recent days to catch a reorg (0 disables).
MARKETPLACE_RECONCILIATION_RECHECK_DAYS=7
# Legacy no-payment demo; keep false so nothing is granted without a payment.
MARKETPLACE_ALLOW_SIMULATED_PURCHASES=false

# SatoshiCore AI (optional, free Gemini key from https://aistudio.google.com/apikey)
SATOSHICORE_AI_PROVIDER=gemini
SATOSHICORE_AI_API_KEY=
SATOSHICORE_AI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# GIFs in the emoji panel (optional, free key from https://developers.giphy.com/dashboard/)
GIPHY_API_KEY=

# Background (Web Push) notifications. Generate once with:
#   docker compose -f docker-compose.prod.yml run --rm web python manage.py generate_vapid_keys --subject mailto:you@example.com
# Keep the same keys forever; empty = background notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: store uploads in S3-compatible storage instead of the server disk.
# USE_S3_MEDIA=True
# S3_BUCKET=mhtalk-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Required before deploy/backup.sh will run: age public recipient (age1...).
# The matching private identity must be kept offline, separately from this host.
# New backups are encrypted before they reach disk or an offsite destination.
BACKUP_AGE_RECIPIENT=
# Optional offsite destination configured in rclone (e.g. gdrive:nsat-backups).
# Uploads contain encrypted artifacts only. Never use a public/shared Drive folder.
BACKUP_REMOTE=
# Optional macOS Keychain service label for the encrypted rclone config passphrase.
BACKUP_RCLONE_KEYCHAIN_SERVICE=

# Optional second site on this server (SaaS Billing demo, separate stack).
# BILLING_DOMAIN=billing.example.com

# Optional third site (MarketHub demo, separate stack).
# MARKETHUB_DOMAIN=markethub.example.com
# Advanced Blog System demo on the same server (own stack, see its deploy/DEPLOY.md)
# BLOG_DOMAIN=blog.example.com
